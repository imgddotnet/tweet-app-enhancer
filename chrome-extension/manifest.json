{
  "manifest_version": 3,
  "name": "Tweet.app Enhancer",
  "version": "2.3.0",
  "description": "Zoom, widths, link cards, translation, Tenor GIF search, notifications and more for app.tweet.app.",
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "https://app.tweet.app/*",
    "https://translate.googleapis.com/*",
    "https://clients5.google.com/*",
    "https://*/*",
    "http://*/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://app.tweet.app/*"
      ],
      "js": [
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
